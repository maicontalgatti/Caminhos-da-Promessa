			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Paz, viajante. Chegou na hora em que o sol se põe sobre Belém. Sente-se, se quiser.",
			"hash": "b8aca303863f7668113570ddc6871e2d109adcc6a80aaeb544b9b19a884cafbc",
			"file": "res://assets/audio/voice/bn_tamir_talk__hello.ogg",
