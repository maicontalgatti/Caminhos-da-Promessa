				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/bye",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Descanse, viajante. Amanhã cedo as ovelhas saem de novo para o pasto.",
			"hash": "53eb7fabcc6f87c0fa6a6fbce1eb7266c6d7d5f731ab6348c721e7e7ad01a73d",
			"file": "res://assets/audio/voice/bn_tamir_talk__bye.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 5.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/after_again",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "O fogo ainda está aceso. O rebanho dorme.",
			"hash": "d23fc0d73a67cd71ad7b0546501bb6dd68279e7fe228e35bad153c4de1cc6260",
			"file": "res://assets/audio/voice/bn_tamir_talk__after_again.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 3.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/again",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "O vento da encosta esfria depressa quando o sol se vai. Fique perto do fogo, viajante.",
			"hash": "75ff62daf6c1018ae251e12b9d0faa56f25f9b1eb7b08b94e6a81a3e854d2dd5",
			"file": "res://assets/audio/voice/bn_tamir_talk__again.ogg",
