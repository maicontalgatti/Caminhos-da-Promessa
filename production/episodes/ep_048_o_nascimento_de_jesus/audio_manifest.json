				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/hello2",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Só não posso parar agora. Quatro animais do meu rebanho se afastaram pastando, e todos precisam entrar no aprisco antes da noite.",
			"hash": "c9e4c08b131789ce0771fc2b994ee8218a39bc3ac18824ed23d2c8179512d38a",
			"file": "res://assets/audio/voice/bn_tamir_talk__hello2.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 9.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/hello3",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "O aprisco é aquele muro de pedra lá embaixo, com galhos de espinho por cima. De noite, só se entra pela abertura do portão.",
			"hash": "430f1ccc04974729edb0e468badd71bd343d19a0bb5b857c1e9c46611c45a4de",
			"file": "res://assets/audio/voice/bn_tamir_talk__hello3.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 9.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/hello4",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Junto ao portão, os vizinhos vigiam o rebanho deles. Cada um cuida do seu rebanho.",
			"hash": "df054b6a156f05fca6df72b352488c864c38c0ff824b2c0981497ecbe5db3e6d",
			"file": "res://assets/audio/voice/bn_tamir_talk__hello4.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 6.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/hello5",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Daqui de cima eu vejo as desgarradas: uma nos terraços, perto do caminho por onde você chegou; uma nos espinhos, encosta abaixo; a cabra nas rochas; e outra perto da boca da gruta.",
			"hash": "c9ac4f70c59dbe795736d54fd904aa1dfe81e6708b0698143eb6109468d69439",
			"file": "res://assets/audio/voice/bn_tamir_talk__hello5.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 13.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/flock_waiting",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Ainda falta trazer algumas. Siga o balido: nos terraços perto da entrada, nos espinhos encosta abaixo, nas rochas e na boca da gruta.",
			"hash": "c0374a06fc2c0f8a56f1a9c4201e749c0a1c0d8afdc76f1879bf1a4e087ae179",
			"file": "res://assets/audio/voice/bn_tamir_talk__flock_waiting.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 9.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/wood_ask",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Todas no aprisco. Obrigado, viajante. Agora, o fogo.",
			"hash": "cc1e7990e53b124aa047d1aae0d5a293daa6c716e4995eb20ab8b384bf44eb4d",
			"file": "res://assets/audio/voice/bn_tamir_talk__wood_ask.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 3.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/wood_ask2",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Lenha aqui é pouca: só galhos secos dos arbustos de espinho. Traga três, e o fogo aguenta até o meu turno.",
			"hash": "4091498816b618c0b6fa7acc0f5ab12981cc7f3a8f904ae5ab8191a23451cce0",
			"file": "res://assets/audio/voice/bn_tamir_talk__wood_ask2.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 7.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/wood_waiting",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Três galhos secos bastam. Procure junto aos arbustos espalhados pela encosta.",
			"hash": "7838549fbf9ae5db7963c689d053b2f34ff041b4279358c0f5ba8eb542be40a4",
			"file": "res://assets/audio/voice/bn_tamir_talk__wood_waiting.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 5.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/deliver",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Galhos secos e bem escolhidos. Agora, sim.",
			"hash": "1f116c5e4dd731afe5836f95dfb39f244addbf3db9ec4fdc388b01e5e79479f9",
			"file": "res://assets/audio/voice/bn_tamir_talk__deliver.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 3.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/deliver2",
			"speaker": "narrator",
			"voice_profile": "narrator_v1",
			"kind": "narration",
			"text": "Tamir sopra as brasas, e o fogo pega. O sol some atrás da crista de Belém, e a noite cai sobre os campos.",
			"hash": "bf4c7c1a3df1144fa0e99ac64e3ead0a4b7f422a4332b5e5c492697be89a3734",
			"file": "res://assets/audio/voice/bn_tamir_talk__deliver2.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 7.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/deliver3",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Vamos dividir a noite. Eu durmo primeiro; você fica de vigia.",
			"hash": "e76283796336ca7c12cf7256ed5d48a7ff808ac4f21a2446e99a3255320e65b2",
			"file": "res://assets/audio/voice/bn_tamir_talk__deliver3.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 4.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/deliver4",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Sente-se na pedra ao lado do fogo. Dali se vê o aprisco inteiro e o fogo dos vizinhos. Se algum animal rondar o muro, me acorde.",
			"hash": "1bf4259e3f07f8b8957e6763122da0ca207087fb0e96bbfe4f994b3a6fad771a",
			"file": "res://assets/audio/voice/bn_tamir_talk__deliver4.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 9.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/deliver5",
			"speaker": "narrator",
			"voice_profile": "narrator_v1",
			"kind": "narration",
			"text": "Tamir se enrola no manto, perto do fogo, e fecha os olhos.",
			"hash": "367ae7f4a3f99d87668111e043a7076b92e5f63ae355912329a9054e52a8b838",
			"file": "res://assets/audio/voice/bn_tamir_talk__deliver5.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 4.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/asleep",
			"speaker": "narrator",
			"voice_profile": "narrator_v1",
			"kind": "narration",
			"text": "Tamir dorme enrolado no manto, perto do fogo. A vigília agora é sua.",
			"hash": "d5ee1d7854798895b7a5ffa4e0dda9c773f853c3a321a299abc4b24c67248c1e",
			"file": "res://assets/audio/voice/bn_tamir_talk__asleep.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 5.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/asleep_late",
			"speaker": "narrator",
			"voice_profile": "narrator_v1",
			"kind": "narration",
			"text": "Tamir continua dormindo, enrolado no manto. Lá em cima, o caminho de Belém sobe no escuro.",
			"hash": "4728a51d5c17d5074ad43cb3e7d32b09bf1a66684d5cd56b014745485c17df06",
			"file": "res://assets/audio/voice/bn_tamir_talk__asleep_late.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 6.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/after",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Ainda acordado, viajante? Eu também. Acordei com vozes no caminho.",
			"hash": "75ec16f0c2af8f094302160884cac6df473a4aed7192ef8418e09c9502580e93",
			"file": "res://assets/audio/voice/bn_tamir_talk__after.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 4.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/after2",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Eram os vizinhos do portão, voltando de Belém. Vinham louvando a Deus.",
			"hash": "20c8e73ecf33e2546dab7e443b1d4748ac6bb07f1a758e11c8034ec3af4e7b34",
			"file": "res://assets/audio/voice/bn_tamir_talk__after2.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 5.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/after3",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Pararam junto ao fogo e contaram o que lhes tinha sido dito a respeito de um menino que eles viram em Belém.",
			"hash": "92483000ad68a682bb70b87eaf5247a7fb46c7c7871a82a1698c7477afdc7f26",
			"file": "res://assets/audio/voice/bn_tamir_talk__after3.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 7.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/after4",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "Eu não vi nada disso. Só ouvi. E fiquei admirado. Não sei dizer mais do que isso.",
			"hash": "84f7bb8c6f9f8711ce827f7564ac1ff957c87bb345b98e01591a6d81df3e00bf",
			"file": "res://assets/audio/voice/bn_tamir_talk__after4.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 6.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/after5",
			"speaker": "narrator",
			"voice_profile": "narrator_v1",
			"kind": "narration",
			"text": "(Resumo do jogo, na voz de Tamir. Tamir é fictício; Lucas 2:17-18 não diz quem ouviu. O texto conta o que os pastores fizeram:)",
			"hash": "07e3f89d067ba7d5ee3fe234394398707b2a2c38436a1b48eceb244c2cfb9514",
			"file": "res://assets/audio/voice/bn_tamir_talk__after5.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 9.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/after6",
			"speaker": "narrator",
			"voice_profile": "narrator_v1",
			"kind": "scripture",
			"text": "Quando o viram, contaram a todos o que lhes havia sido dito a respeito daquele menino. Todos os que ouviram ficaram admirados com o que os pastores lhes contaram.",
			"hash": "7c355d6a21e63b33ac7a854413a96e1520367ca703d8bfb5e23f732494f8477f",
			"file": "res://assets/audio/voice/bn_tamir_talk__after6.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 11.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			},
			"scripture": "Luke 2:17-18",
			"translation": "bpm"
		},
		{
			"line_id": "bn_tamir_talk/after7",
			"speaker": "narrator",
			"voice_profile": "narrator_v1",
			"kind": "scripture",
			"text": "Os pastores voltaram, glorificando e louvando a Deus por todas as coisas que tinham ouvido e visto, exatamente como lhes havia sido dito.",
			"hash": "80fc325a830638c9e8a252fb86a94c74efcac1654825fc7e82750bdfb7548cfd",
			"file": "res://assets/audio/voice/bn_tamir_talk__after7.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 10.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			},
			"scripture": "Luke 2:20",
			"translation": "bpm"
		},
		{
			"line_id": "bn_tamir_talk/after_choice",
			"speaker": "bn_tamir",
			"voice_profile": "bn_tamir",
			"kind": "fictional_dialogue",
			"text": "A noite ainda não acabou. Fique um pouco junto ao fogo.",
			"hash": "214ac53373ee5a1dc494dbee7694f1e7d726471ac5a051b78cb85b8734c72fa8",
			"file": "res://assets/audio/voice/bn_tamir_talk__after_choice.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 4.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "bn_tamir_talk/read",
			"speaker": "narrator",
			"voice_profile": "narrator_v1",
			"kind": "narration",
			"text": "Você abre o diário de viagem nos trechos de Lucas 2.",
			"hash": "33aacdd4bc0ad62f07a59d42ff84e91771083d7716977abadc62e8213163eaca",
			"file": "res://assets/audio/voice/bn_tamir_talk__read.ogg",
