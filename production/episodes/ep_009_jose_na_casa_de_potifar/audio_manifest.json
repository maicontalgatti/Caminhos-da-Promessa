			"speaker": "egypt_senbi",
			"voice_profile": "egypt_senbi",
			"kind": "fictional_dialogue",
			"text": "Obrigado, estrangeiro. Amanhã cedo é a vez do linho.",
			"hash": "5155ffc1335a3c42b462d2a0600e00fa4fe9c3e65096e29aa38b23f9d8e9c343",
			"file": "res://assets/audio/voice/senbi_talk__thanks2.ogg",
