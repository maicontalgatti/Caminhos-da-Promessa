			"speaker": "egypt_ipi",
			"voice_profile": "egypt_ipi",
			"kind": "fictional_dialogue",
			"text": "Muita gente trabalha aqui: padeiros, tecelãs, lavradores, quem cuida do gado. Meryt guarda o depósito; Senbi está na eira, depois do muro.",
			"hash": "dcfc946331bc62ea4604962073b5448388944673e3c76971487eb2e5e3a97809",
