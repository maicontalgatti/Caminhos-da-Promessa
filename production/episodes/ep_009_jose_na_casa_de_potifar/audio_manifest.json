			"pronunciation": {},
			"target_seconds": 5.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "senbi_talk/seasons",
			"speaker": "egypt_senbi",
			"voice_profile": "egypt_senbi",
			"kind": "fictional_dialogue",
			"text": "O ano aqui tem três tempos: a cheia, quando o rio cobre os campos; a semeadura; e a colheita, quando o sol seca a cevada.",
			"hash": "90bdeb01fc2bb4ae7387342791d3306cb67146f8e1ecbebbb2f349800bef60ce",
			"file": "res://assets/audio/voice/senbi_talk__seasons.ogg",
