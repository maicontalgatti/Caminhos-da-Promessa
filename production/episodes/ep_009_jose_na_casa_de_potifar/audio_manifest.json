		},
		{
			"line_id": "senbi_talk/greet",
			"speaker": "egypt_senbi",
			"voice_profile": "egypt_senbi",
			"kind": "fictional_dialogue",
			"text": "Paz, estrangeiro. Chegou em tempo de colheita: aqui ninguém fica parado.",
			"hash": "ce1625a70305db384ebb18d50b09f318f4a3612d9d895a25dd9d5309a77949e8",
			"file": "res://assets/audio/voice/senbi_talk__greet.ogg",
			"status": "pending",
