			}
		},
		{
			"line_id": "meryt_talk/not_yet",
			"speaker": "egypt_meryt",
			"voice_profile": "egypt_meryt",
			"kind": "fictional_dialogue",
			"text": "A cevada de Senbi? Traga os três sacos de uma vez, que eu confiro e mando anotar.",
			"hash": "54dc6fc9b46e246b8ba7f3770dabea7e9523cd5107060761a166a170086d6e53",
			"file": "res://assets/audio/voice/meryt_talk__not_yet.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 6.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "meryt_talk/delivery",
			"speaker": "egypt_meryt",
			"voice_profile": "egypt_meryt",
			"kind": "fictional_dialogue",
			"text": "Três sacos da eira de Senbi. Cheios e bem amarrados. Pode pôr ali, junto à parede.",
			"hash": "57bf2e0da748489792d02c47a16f8efaac29c9ab6c9d92cc95c86d976487528a",
			"file": "res://assets/audio/voice/meryt_talk__delivery.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 6.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "meryt_talk/delivery2",
			"speaker": "egypt_meryt",
			"voice_profile": "egypt_meryt",
			"kind": "fictional_dialogue",
			"text": "Três sacos de cevada, entregues hoje. Vou mandar anotar. Avise Senbi que chegaram.",
			"hash": "54e8aea5dfc93b5cdb24441bc47c08458d7006f1a2fac0405d4ea0aac3cfca6e",
			"file": "res://assets/audio/voice/meryt_talk__delivery2.ogg",
