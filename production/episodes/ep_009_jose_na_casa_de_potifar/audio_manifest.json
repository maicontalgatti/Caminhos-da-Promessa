			}
		},
		{
			"line_id": "meryt_talk/store",
			"speaker": "egypt_meryt",
			"voice_profile": "egypt_meryt",
			"kind": "fictional_dialogue",
			"text": "Eu cuido do depósito. Cada jarro tem tampa de barro com um selo: se o selo está inteiro, ninguém mexeu no que tem dentro.",
			"hash": "076f65b76d4eb6d1d0f9bf701f2838f35a69f79ac8d307bee57f903d60379e4d",
			"file": "res://assets/audio/voice/meryt_talk__store.ogg",
