				"real_person_voice": false
			}
		},
		{
			"line_id": "meryt_talk/hub",
			"speaker": "egypt_meryt",
			"voice_profile": "egypt_meryt",
			"kind": "fictional_dialogue",
			"text": "Precisa de alguma coisa?",
			"hash": "29c233823e83c1146c1a268878d77db37cdcb6ebfbb6177b361bfc259363dddf",
			"file": "res://assets/audio/voice/meryt_talk__hub.ogg",
