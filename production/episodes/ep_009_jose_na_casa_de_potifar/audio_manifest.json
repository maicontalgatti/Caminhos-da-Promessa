				"real_person_voice": false
			}
		},
		{
			"line_id": "meryt_talk/store2",
			"speaker": "egypt_meryt",
			"voice_profile": "egypt_meryt",
			"kind": "fictional_dialogue",
			"text": "O grão sai em rações, medido no hekat, a nossa medida de grão. O escriba anota o que entra e o que sai.",
			"hash": "ef77b180045f2b37163dce4b7af66754b6e00c63e19159c0a44ca291b406ce87",
			"file": "res://assets/audio/voice/meryt_talk__store2.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 7.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "meryt_talk/store3",
			"speaker": "egypt_meryt",
			"voice_profile": "egypt_meryt",
			"kind": "fictional_dialogue",
			"text": "É tempo de colheita, e o grão novo está chegando. Por isso conto tudo duas vezes.",
			"hash": "c3786dbd2c477f270391f58fb496009eae6c9491ce28671f175c8e4f73a4b00a",
			"file": "res://assets/audio/voice/meryt_talk__store3.ogg",
