			"emotion": "",
			"pronunciation": {},
			"target_seconds": 8.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "senbi_talk/seasons2",
			"speaker": "egypt_senbi",
			"voice_profile": "egypt_senbi",
			"kind": "fictional_dialogue",
			"text": "A água deixa a terra escura e boa. Lá longe, onde ela não chega, só há areia.",
			"hash": "04803f8d9fea3797cb905df4f80d79fa1530cfe191d06de2590f387646f43d34",
			"file": "res://assets/audio/voice/senbi_talk__seasons2.ogg",
