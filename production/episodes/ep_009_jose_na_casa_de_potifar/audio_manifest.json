			"speaker": "egypt_ipi",
			"voice_profile": "egypt_ipi",
			"kind": "fictional_dialogue",
			"text": "Vá em paz. E não deixe os gansos entrarem na cozinha.",
			"hash": "cdf1d22d5ec91ef2199a56f676eddb3743584fadcf2389a18eb5f85b32a1dfcc",
