				"real_person_voice": false
			}
		},
		{
			"line_id": "meryt_talk/bye",
			"speaker": "egypt_meryt",
			"voice_profile": "egypt_meryt",
			"kind": "fictional_dialogue",
			"text": "Vá em paz. E feche a porta do depósito se passar por ela.",
			"hash": "316a321a01a9050520324dea452f69e6c6a285afe10f86ca3eb1689ffc87cabe",
			"file": "res://assets/audio/voice/meryt_talk__bye.ogg",
