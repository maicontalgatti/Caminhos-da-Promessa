		},
		{
			"line_id": "meryt_talk/greet",
			"speaker": "egypt_meryt",
			"voice_profile": "egypt_meryt",
			"kind": "fictional_dialogue",
			"text": "Ipi deixou você passar? Então pode olhar. Só não mexa nos jarros, por favor.",
			"hash": "eba399e719bf840c815fd6ef591ef12ed52ad40a51de02b8bb323a4c03cfd6da",
			"file": "res://assets/audio/voice/meryt_talk__greet.ogg",
