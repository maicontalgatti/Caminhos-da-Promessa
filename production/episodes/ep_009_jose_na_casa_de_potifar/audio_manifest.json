			"pronunciation": {},
			"target_seconds": 5.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "senbi_talk/hub",
			"speaker": "egypt_senbi",
			"voice_profile": "egypt_senbi",
			"kind": "fictional_dialogue",
			"text": "Quer saber mais alguma coisa?",
			"hash": "5e4e4bfddfff132aac0dea1744d027ea254abfed9d48c0e04def45bf8931b254",
			"file": "res://assets/audio/voice/senbi_talk__hub.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 2.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "senbi_talk/crops",
			"speaker": "egypt_senbi",
			"voice_profile": "egypt_senbi",
			"kind": "fictional_dialogue",
			"text": "Cevada e trigo, para o pão e a cerveja. E linho, para os panos: a gente arranca o linho com raiz e deixa secar em feixes.",
			"hash": "91ae2d63c0dd2e21ecba5c390ce2d15d87b38e4bbe9d7196e76e1015122462d9",
			"file": "res://assets/audio/voice/senbi_talk__crops.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 8.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "senbi_talk/request",
			"speaker": "egypt_senbi",
			"voice_profile": "egypt_senbi",
			"kind": "fictional_dialogue",
			"text": "Preciso, sim. Debulhei a cevada e enchi três sacos, mas ainda tenho a palha para juntar.",
			"hash": "8b784c60fb39281c84e858a7bc60fb2a101fba04e2a660e042846c34e28921dd",
			"file": "res://assets/audio/voice/senbi_talk__request.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 6.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "senbi_talk/request2",
			"speaker": "egypt_senbi",
			"voice_profile": "egypt_senbi",
			"kind": "fictional_dialogue",
			"text": "Leve os sacos até Meryt, no depósito, antes do fim do dia. Ela confere e manda anotar. Estão aqui, em volta da eira.",
			"hash": "c022ec4269ad8f4973935f5ac82a38612239ce265a680a23cd628d8440b285bf",
			"file": "res://assets/audio/voice/senbi_talk__request2.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 8.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "senbi_talk/remind",
			"speaker": "egypt_senbi",
			"voice_profile": "egypt_senbi",
			"kind": "fictional_dialogue",
			"text": "Os três sacos estão em volta da eira. Meryt fica na porta do depósito, a leste do pátio.",
			"hash": "a17d4936057d3ef5a40edec120bbb439ce64874136735a9a8b57934fcbbfdf46",
			"file": "res://assets/audio/voice/senbi_talk__remind.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 6.5,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
			"line_id": "senbi_talk/thanks",
			"speaker": "egypt_senbi",
			"voice_profile": "egypt_senbi",
			"kind": "fictional_dialogue",
			"text": "Meryt recebeu os três? Então a cevada está guardada antes de escurecer.",
			"hash": "b71aba3d7c19db3d1888a506ce80ea1213be76c77ba9da2f6652d54086b61b4e",
			"file": "res://assets/audio/voice/senbi_talk__thanks.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 5.0,
			"rights": {
				"provider": "",
				"commercial_license": "pending",
				"real_person_voice": false
			}
		},
		{
