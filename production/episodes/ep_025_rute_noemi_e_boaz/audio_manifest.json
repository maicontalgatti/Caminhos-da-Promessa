				"real_person_voice": false
			}
		},
		{
			"line_id": "bf_ilan_talk/waiting",
			"speaker": "bf_ilan",
			"voice_profile": "bf_ilan",
			"kind": "fictional_dialogue",
			"text": "Os feixes amarrados estão nas fileiras ceifadas. Quatro já ajudam; o jumento leva o resto para a eira.",
			"hash": "789040e92459ecb8405827b15fba32e95119470f7e3eb0b7c16a842f1f132d63",
			"file": "res://assets/audio/voice/bf_ilan_talk__waiting.ogg",
			"status": "pending",
			"emotion": "",
			"pronunciation": {},
			"target_seconds": 7.5,
			"rights": {
				"provider": "",
