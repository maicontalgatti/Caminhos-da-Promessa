				"real_person_voice": false
			}
		},
		{
			"line_id": "bf_ilan_talk/request2",
			"speaker": "bf_ilan",
			"voice_profile": "bf_ilan",
			"kind": "fictional_dialogue",
			"text": "Lá embaixo, no canto do campo, a cevada ainda está de pé. Os feixes prontos estão nas fileiras. Pressione E perto de um feixe para pegá-lo.",
			"hash": "a05776c073d68942cba8974d8d4d171a94c3dad79d66a49b5736c21d8126d95e",
			"file": "res://assets/audio/voice/bf_ilan_talk__request2.ogg",
