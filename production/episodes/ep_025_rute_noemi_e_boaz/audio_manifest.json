			"speaker": "bf_ilan",
			"voice_profile": "bf_ilan",
			"kind": "fictional_dialogue",
			"text": "Se quiser ajudar, junte os feixes amarrados nas fileiras já ceifadas e traga para mim. Quatro já fazem diferença.",
			"hash": "37ce677905ab3f44a5795b425764f36541a5b86060f5fe3037466e107a9bde7c",
			"file": "res://assets/audio/voice/bf_ilan_talk__request.ogg",
