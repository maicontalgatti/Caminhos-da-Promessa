		{
			"line_id": "well_examine/n1",
			"speaker": "narrator",
			"voice_profile": "narrator_v1",
			"kind": "narration",
			"text": "Um poço de pedra. Lá embaixo, a água reflete um pedaço do céu.",
			"hash": "49d2bafcd47abc86fdbd7dfd2947ce2f23bee9c42bed9dd809d587d3e586854b",
			"file": "res://assets/audio/voice/well_examine__n1.ogg",
			"status": "pending",
