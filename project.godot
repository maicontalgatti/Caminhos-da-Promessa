; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Caminhos da Promessa"
config/description="RPG bíblico de exploração em pixel art 2D."
config/version="0.6.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.png"

[autoload]

Settings="*res://scripts/core/settings.gd"
GameData="*res://scripts/core/game_data.gd"
Bible="*res://scripts/bible/bible.gd"
SaveManager="*res://scripts/save/save_manager.gd"
GameState="*res://scripts/core/game_state.gd"
DialogueManager="*res://scripts/dialogue/dialogue_manager.gd"
QuestManager="*res://scripts/quests/quest_manager.gd"
Discoveries="*res://scripts/bible/discoveries.gd"
Inventory="*res://scripts/items/inventory.gd"
Collectibles="*res://scripts/items/collectibles.gd"
WorldManager="*res://scripts/world/world_manager.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
AudioManager="*res://scripts/core/audio_manager.gd"

[caminhos]

content/channel="prototype"
content/bible_translation="bpm"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/quest_editor/plugin.cfg")

[gui]

theme/custom="res://assets/ui/theme.tres"

